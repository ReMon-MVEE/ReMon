diff -r --unified linux-3.13.0.orig/arch/x86/kernel/ptrace.c linux-3.13.0/arch/x86/kernel/ptrace.c
--- linux-3.13.0.orig/arch/x86/kernel/ptrace.c	2014-01-20 03:40:07.000000000 +0100
+++ linux-3.13.0/arch/x86/kernel/ptrace.c	2015-08-11 18:54:34.592363780 +0200
@@ -1533,3 +1533,32 @@
 
 	user_enter();
 }
+
+/* TODO: move this to subarch so we can get this shit working on i386 */
+unsigned long arch_ptrace_get_program_counter()
+{
+  return getreg(current, 8 * 16); /* RIP = 16 */
+}
+
+/* This gets called at the syscall entry site */
+unsigned char arch_ptrace_utcb_bypass(struct pt_regs * regs)
+{
+	/* check if the UTCB wants to bypass the kernel */
+	if ((unsigned int)regs->r12 == current->mm->utcb_info.utcb_key)
+    {
+		/* check the syscall no */
+		if (utcb_is_unchecked_syscall(current->mm->utcb_info.utcb_masked_syscalls, regs->orig_ax))
+		{
+			/* final check: did this syscall originate from the registered UTCB? */
+			unsigned long pc = arch_ptrace_get_program_counter();
+			if (pc >= current->mm->utcb_info.utcb_start && pc <= current->mm->utcb_info.utcb_end)
+				return 1;
+		}
+      
+		/* uh oh, the UTCB is being a bad boy. Refuse the bypass and clear r11 */
+		putreg(current, 8 * 3, 0x0); /* R12 = 3 */
+		return 2;
+    }
+
+	return 0;
+}
