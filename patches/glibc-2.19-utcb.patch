diff -N -r --unified glibc-2.19/csu/utcb_stub_asm.S glibc-2.19-utcb/csu/utcb_stub_asm.S
--- glibc-2.19/csu/utcb_stub_asm.S	1970-01-01 01:00:00.000000000 +0100
+++ glibc-2.19-utcb/csu/utcb_stub_asm.S	2015-06-06 13:27:41.934120918 +0200
@@ -0,0 +1,22 @@
+/* This just performs the syscall and returns, it does not set errno
+   like the normal syscall function does. We can use it as a weak
+   symbol until the actual UTCB overrides it */
+	
+        .text
+        .globl utcb_syscall
+        .type utcb_syscall,@function
+		.weak utcb_syscall
+		.cfi_startproc
+        .align 16
+
+utcb_syscall:
+        movq %rdi, %rax
+        movq %rsi, %rdi
+        movq %rdx, %rsi
+        movq %rcx, %rdx
+        movq %r8, %r10
+        movq %r9, %r8
+        movq 8(%rsp), %r9
+        syscall
+        ret
+		.cfi_endproc
